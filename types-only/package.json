{
  "name": "@eulab/openwaunlocked-types-only",
  "version": "1.0.0",
  "description": "Types generated from the @eulab/openwaunlocked package",
  "scripts": {
    "build": "tsc",
    "deploy": "npm run build && npm version",
    "pub": "npm run build && npm run _ver && npm publish",
    "_ver": "awk -F'\"' '/\"version\": \".+\"/{ print $4; exit; }' ../package.json | xargs -I{} npm version {} --allow-same-version",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "types": "dist/index.d.ts",
  "keywords": [
    "typescript",
    "ts",
    "types",
    "open-wa",
    "wa-automate"
  ],
  "files": [
    "dist/index.d.ts",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git"
  },
  "author": "EULAB",
  "publishConfig": {
    "access": "public"
  },
  "license": "H-DNH V1.0",
  "bugs": {
    "url": "https://github.com/open-wa/wa-automate-nodejs/issues"
  },
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "engines": {
    "node": ">=12.18.3",
    "npm": ">=7.9.0"
  }
}
