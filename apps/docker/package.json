{
  "name": "@eulab/openwaunlocked-docker",
  "version": "1.0.0",
  "description": "This is a simple app that will expose an API that you can use to control your whatsapp instance.",
  "type": "module",
  "scripts": {
    "test": "node -e \"console.log('No tests defined for @eulab/openwaunlocked-docker')\"",
    "start": "npm update && npx @eulab/openwaunlocked --in-docker -p 8080 --npm-options=--ignore-scripts",
    "sessiondata": "npx @eulab/openwaunlocked --disable-spins --session-data-only"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-wa/wa-automate-docker.git"
  },
  "author": "EULAB",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/open-wa/wa-automate-docker/issues"
  },
  "homepage": "https://github.com/open-wa/wa-automate-docker#readme",
  "dependencies": {
    "@eulab/openwaunlocked": "workspace:*",
    "npm": "^12.1.0"
  },
  "private": true
}
