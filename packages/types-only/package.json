{
  "name": "@eulab/openwaunlocked-types-only",
  "version": "1.0.0",
  "description": "Lightweight type-only re-exports from @eulab/openwaunlocked-schema — zero runtime dependencies",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rimraf dist"
  },
  "keywords": [
    "typescript",
    "ts",
    "types",
    "open-wa",
    "wa-automate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "packages/types-only"
  },
  "author": "EULAB",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        },
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        }
      }
    },
    "registry": "https://registry.npmjs.org/"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@eulab/openwaunlocked-schema": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  }
}
