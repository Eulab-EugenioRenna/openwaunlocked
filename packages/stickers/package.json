{
  "name": "@eulab/openwaunlocked-stickers",
  "author": "EULAB",
  "version": "1.0.0",
  "description": "Local sticker rendering with automatic browser or standalone WASM execution",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "packages/stickers"
  },
  "engines": {
    "node": ">=22.21.1"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./browser": {
      "types": "./src/browser.d.mts",
      "browser": "./src/browser-web.mjs",
      "default": "./src/browser.mjs"
    },
    "./library": {
      "types": "./src/library.d.mts",
      "default": "./src/library.mjs"
    },
    "./webp": {
      "types": "./src/webp.d.mts",
      "default": "./src/webp.mjs"
    },
    "./resources": {
      "types": "./src/resources.d.mts",
      "default": "./src/resources.mjs"
    }
  },
  "bin": {
    "openwaunlocked-sticker": "./src/cli.mjs"
  },
  "files": [
    "src",
    "wasm",
    "README.md",
    "LICENSE.md",
    "NOTICE.md",
    "licenses"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  }
}
