{
  "name": "@eulab/openwaunlocked-cli",
  "author": "EULAB",
  "version": "1.0.0",
  "description": "CLI for EULAB Open WhatsApp automation - Easy API mode",
  "main": "./dist/index.cjs",
  "module": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "openwaunlocked-cli": "./dist/bin.cjs"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.cjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.cts"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/bin.ts --format cjs",
    "dev": "tsdown src/index.ts src/bin.ts --format cjs --watch",
    "start": "node dist/bin.cjs",
    "test": "vitest run",
    "lint": "oxlint src",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@eulab/openwaunlocked-core": "workspace:*",
    "@eulab/openwaunlocked-hyperemitter": "workspace:*",
    "@eulab/openwaunlocked": "workspace:*",
    "ink": "^7.1.1",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "ws": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@types/ws": "^8.18.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.cjs",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.cts"
      }
    },
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "packages/cli"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  }
}
