{
  "name": "@eulab/openwaunlocked",
  "author": "EULAB",
  "type": "module",
  "version": "1.0.0",
  "description": "WhatsApp automation CLI and API server",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.cjs",
      "types": "./dist/index.d.cts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "require": "./dist/index.cjs",
        "import": "./dist/index.cjs",
        "types": "./dist/index.d.cts"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "openwaunlocked": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@elastic/elasticsearch": "catalog:",
    "@hono/node-server": "catalog:",
    "@eulab/openwaunlocked-api": "workspace:*",
    "@eulab/openwaunlocked-client": "workspace:*",
    "@eulab/openwaunlocked-config": "workspace:*",
    "@eulab/openwaunlocked-core": "workspace:*",
    "@eulab/openwaunlocked-driver-interface": "workspace:*",
    "@eulab/openwaunlocked-driver-lightpanda": "workspace:*",
    "@eulab/openwaunlocked-driver-puppeteer": "workspace:*",
    "@eulab/openwaunlocked-logger": "workspace:*",
    "@eulab/openwaunlocked-runtime-core": "workspace:*",
    "@eulab/openwaunlocked-runtime-node": "workspace:*",
    "@eulab/openwaunlocked-schema": "workspace:*",
    "@eulab/openwaunlocked-session-sync": "workspace:*",
    "boxen": "^9.0.0",
    "chrome-launcher": "^1.2.1",
    "effect": "catalog:",
    "hono": "catalog:",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "packages/wa-automate"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  }
}
