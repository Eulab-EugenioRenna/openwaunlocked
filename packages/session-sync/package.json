{
  "name": "@eulab/openwaunlocked-session-sync",
  "author": "EULAB",
  "version": "1.0.0",
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "scripts": {
    "build": "tsdown src/index.ts --format cjs",
    "dev": "tsdown src/index.ts --format cjs --watch",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@eulab/openwaunlocked-schema": "workspace:*",
    "chokidar": "^5.0.0",
    "pico-s3": "^2.11.0",
    "simple-zstd": "^2.1.0",
    "tar-fs": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/tar-fs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "packages/session-sync"
  },
  "description": "Synchronize Open-WA sessions to remote storage",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.cts",
        "require": "./dist/index.cjs",
        "default": "./dist/index.cjs"
      }
    },
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  }
}
