{
  "name": "@eulab/openwaunlocked-socket-client",
  "version": "1.0.0",
  "description": "Easily connect to remote instances of the EASY API",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./calling-platform": {
      "browser": "./dist/calling-platform.browser.mjs",
      "bun": "./src/calling-platform.ts",
      "types": "./dist/calling-platform.d.mts",
      "import": "./dist/calling-platform.mjs",
      "require": "./dist/calling-platform.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src test",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run test/SocketClient.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "packages/socket-client"
  },
  "keywords": [
    "wa-automate",
    "easy-api",
    "remote",
    "socket"
  ],
  "author": "EULAB",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.cjs"
      },
      "./calling-platform": {
        "browser": "./dist/calling-platform.browser.mjs",
        "types": "./dist/calling-platform.d.mts",
        "import": "./dist/calling-platform.mjs",
        "require": "./dist/calling-platform.cjs"
      }
    },
    "registry": "https://registry.npmjs.org/"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  },
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "dependencies": {
    "@eulab/openwaunlocked-types-only": "workspace:*",
    "@eulab/openwaunlocked-hyperemitter": "workspace:*",
    "debug": "^4.4.3",
    "effect": "catalog:",
    "eventsource": "^5.1.2",
    "isomorphic-ws": "^5.0.0",
    "ws": "^8.22.0",
    "@eulab/openwaunlocked-schema": "workspace:*",
    "@eulab/openwaunlocked-runtime-node": "workspace:*",
    "@eulab/openwaunlocked-runtime-core": "workspace:*",
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "type": "module",
  "files": [
    "dist"
  ]
}
