{
  "name": "@eulab/openwaunlocked-mcp",
  "author": "EULAB",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server integration for open-wa",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@eulab/openwaunlocked-config": "workspace:*",
    "@eulab/openwaunlocked-schema": "workspace:*",
    "@eulab/openwaunlocked-utils": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:",
    "@modelcontextprotocol/server": "2.3.1",
    "@eulab/openwaunlocked-runtime-core": "workspace:*",
    "standardwebhooks": "1.0.0",
    "ipaddr.js": "2.2.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        },
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        }
      }
    },
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "packages/mcp"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  }
}
