{
  "name": "@eulab/openwaunlocked-driver-interface",
  "author": "EULAB",
  "version": "1.0.0",
  "description": "Browser driver abstraction interfaces for open-wa",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.cjs",
      "types": "./dist/index.d.cts"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs",
    "dev": "tsdown src/index.ts --format cjs --watch",
    "lint": "oxlint src"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "require": "./dist/index.cjs",
        "import": "./dist/index.cjs",
        "types": "./dist/index.d.cts"
      }
    },
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "packages/driver-interface"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  }
}
