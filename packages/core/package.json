{
  "name": "@eulab/openwaunlocked-core",
  "author": "EULAB",
  "version": "1.0.0",
  "description": "Core orchestration backbone for open-wa WhatsApp automation",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "node ../../dev/patches/build.mjs && tsdown src/index.ts --format esm --format cjs && node scripts/copy-launch-script.mjs",
    "dev": "tsdown src/index.ts --format esm --format cjs --watch",
    "test": "vitest run",
    "lint": "oxlint src",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@eulab/openwaunlocked-config": "workspace:*",
    "@eulab/openwaunlocked-driver-interface": "workspace:*",
    "@eulab/openwaunlocked-hyperemitter": "workspace:*",
    "@eulab/openwaunlocked-logger": "workspace:*",
    "@eulab/openwaunlocked-plugin-sdk": "workspace:*",
    "@eulab/openwaunlocked-runtime-core": "workspace:*",
    "@eulab/openwaunlocked-schema": "workspace:*",
    "@eulab/openwaunlocked-session-sync": "workspace:*",
    "effect": "catalog:",
    "hono": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@eulab/openwaunlocked-driver-puppeteer": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@eulab/openwaunlocked-driver-puppeteer": "workspace:*",
    "@eulab/openwaunlocked-driver-playwright": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@eulab/openwaunlocked-driver-puppeteer": {
      "optional": true
    },
    "@eulab/openwaunlocked-driver-playwright": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.mts"
      }
    },
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "packages/core"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  }
}
