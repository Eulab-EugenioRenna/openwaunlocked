{
  "name": "@eulab/openwaunlocked-utils",
  "author": "EULAB",
  "version": "1.0.0",
  "description": "Shared utility functions for open-wa",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "pidtree": "^1.0.0",
    "pidusage": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pidusage": "^2.0.5",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      }
    },
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "open-wa",
    "whatsapp",
    "utils"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "packages/utils"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  }
}
