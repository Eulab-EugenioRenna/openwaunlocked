{
  "name": "@eulab/openwaunlocked-driver-playwright",
  "author": "EULAB",
  "version": "1.0.0",
  "description": "Playwright driver implementation for open-wa",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.cjs",
      "types": "./dist/index.d.cts"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs",
    "dev": "tsdown src/index.ts --format cjs --watch",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@eulab/openwaunlocked-driver-interface": "workspace:*",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "require": "./dist/index.cjs",
        "import": "./dist/index.cjs",
        "types": "./dist/index.d.cts"
      }
    },
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "packages/driver-playwright"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  }
}
