{
  "name": "@eulab/openwaunlocked-api",
  "author": "EULAB",
  "version": "1.0.0",
  "description": "Reusable Easy API transport and runtime explorer layer for open-wa",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.cjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.cts"
    }
  },
  "files": [
    "src",
    "dist",
    "dashboard-neo/dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs && node scripts/copy-dashboard.cjs",
    "dev": "tsdown src/index.ts --format cjs --watch",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@elastic/elasticsearch": "catalog:",
    "@hono/node-server": "catalog:",
    "@eulab/openwaunlocked-mcp": "workspace:*",
    "@eulab/openwaunlocked-schema": "workspace:*",
    "@eulab/openwaunlocked-screencaster": "workspace:*",
    "hono": "catalog:",
    "tree-kill": "^1.2.2",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "devDependencies": {
    "@eulab/openwaunlocked-dashboard-neo": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.cjs",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.cts"
      }
    },
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "packages/api"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  }
}
