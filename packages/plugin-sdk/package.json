{
  "name": "@eulab/openwaunlocked-plugin-sdk",
  "version": "1.0.0",
  "description": "SDK for building open-wa plugins — types, helpers, and the createPlugin() factory",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "src",
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@eulab/openwaunlocked-schema": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      }
    },
    "registry": "https://registry.npmjs.org/"
  },
  "author": "EULAB",
  "license": "SEE LICENSE IN LICENSE.md",
  "keywords": [
    "open-wa",
    "plugin",
    "sdk",
    "whatsapp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  }
}
