{
  "name": "@eulab/openwaunlocked-integration-chatwoot",
  "author": "EULAB",
  "version": "1.0.0",
  "description": "Chatwoot integration plugin for open-wa",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@eulab/openwaunlocked-plugin-sdk": "workspace:*",
    "effect": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@eulab/openwaunlocked-logger": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      }
    },
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eulab-EugenioRenna/openwaunlocked.git",
    "directory": "integrations/chatwoot"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Eulab-EugenioRenna/openwaunlocked#readme",
  "bugs": {
    "url": "https://github.com/Eulab-EugenioRenna/openwaunlocked/issues"
  }
}
